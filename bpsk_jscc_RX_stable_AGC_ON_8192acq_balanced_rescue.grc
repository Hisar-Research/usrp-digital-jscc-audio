- name: epy_block_dual_packet_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ array\n\nclass blk(gr.basic_block):\n    \"\"\"\n    4096-bit low-SNR packet\
      \ detector with soft-assisted acquisition.\n\n    Input 0: differentially decoded\
      \ hard bits (uint8)\n    Input 1: aligned DBPSK soft metric (float32), negative=0,\
      \ positive=1\n\n    Detection policy:\n      1) hard accept when Hamming distance\
      \ <= 1840/4096\n      2) for 1841..1900 errors, accept only when normalized\
      \ soft\n         correlation with the known 4096-bit sync word is >= 0.10\n\n\
      \    Packet extraction / UDP payload behavior is unchanged.\n    \"\"\"\n\n\
      \    def __init__(self, skip_header_bits=96, plain_bytes=488,\n            \
      \     soft_bits=3900, vogeo_bytes=488, sync_tag=\"unused\"):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"4096-bit hard+soft low-SNR detector\"\
      ,\n            in_sig=[np.uint8, np.float32],\n            out_sig=[]\n    \
      \    )\n\n        self.sync_bits = \"\"\
      \n        self.sync_len = len(self.sync_bits)\n        self.sync_int = int(self.sync_bits,\
      \ 2)\n        self.sync_mask = (1 << self.sync_len) - 1\n\n        # Conservative\
      \ hard detector plus a soft-assisted rescue region.\n        self.hard_threshold\
      \ = 1840\n        self.soft_candidate_threshold = 1900\n        self.soft_score_threshold\
      \ = 0.12\n\n        # Expected bipolar sync symbols for the DBPSK soft metric:\n\
      \        # bit 0 -> -1, bit 1 -> +1.\n        self.sync_bipolar = np.fromiter(\n\
      \            (1.0 if c == \"1\" else -1.0 for c in self.sync_bits),\n      \
      \      dtype=np.float32,\n            count=self.sync_len\n        )\n\n   \
      \     self.skip_header_bits = int(skip_header_bits)\n        self.fixed_bytes\
      \ = int(plain_bytes)\n        self.target_bits = self.fixed_bytes * 8\n    \
      \    self.soft_target_bits = int(soft_bits)\n\n        self.out_port = pmt.intern(\"\
      pdus\")\n        self.soft_out_port = pmt.intern(\"soft_pdus\")\n        self.message_port_register_out(self.out_port)\n\
      \        self.message_port_register_out(self.soft_out_port)\n\n        self.shiftreg\
      \ = 0\n        self.search_count = 0\n\n        # Circular buffer holding the\
      \ soft values aligned with the current\n        # 4096-bit hard synchronization\
      \ window.\n        self.sync_soft_buf = np.zeros(self.sync_len, dtype=np.float32)\n\
      \        self.sync_soft_write = 0\n\n        self.state = \"SEARCH\"\n     \
      \   self.skip_left = 0\n\n        self.buf = np.empty(self.target_bits, dtype=np.uint8)\n\
      \        self.soft_buf = np.empty(self.target_bits, dtype=np.float32)\n    \
      \    self.pos = 0\n        self.detections = 0\n\n    def _reset_search(self):\n\
      \        self.shiftreg = 0\n        self.search_count = 0\n        self.sync_soft_write\
      \ = 0\n        self.sync_soft_buf.fill(0.0)\n        self.state = \"SEARCH\"\
      \n        self.skip_left = 0\n        self.pos = 0\n\n    def _soft_sync_score(self):\n\
      \        # Convert the circular buffer into chronological order only for\n \
      \       # candidate windows. Candidates are rare, so this does not burden\n\
      \        # the normal streaming path.\n        w = self.sync_soft_write\n  \
      \      if w == 0:\n            soft_window = self.sync_soft_buf\n        else:\n\
      \            soft_window = np.concatenate(\n                (self.sync_soft_buf[w:],\
      \ self.sync_soft_buf[:w])\n            )\n\n        denom = float(np.sum(np.abs(soft_window)))\n\
      \        if denom <= 1e-12:\n            return 0.0\n\n        return float(np.dot(soft_window,\
      \ self.sync_bipolar) / denom)\n\n    def _start_packet(self, distance, mode,\
      \ soft_score=None):\n        self.state = \"SKIP\"\n        self.skip_left =\
      \ self.skip_header_bits\n        self.pos = 0\n        self.detections += 1\n\
      \n        if soft_score is None:\n            print(\n                \"LONG\
      \ SYNC DETECTED | \"\n                f\"mode={mode} | errors={distance}/4096\
      \ | \"\n                f\"hard_threshold={self.hard_threshold} | \"\n     \
      \           f\"detection={self.detections}\"\n            )\n        else:\n\
      \            print(\n                \"LONG SYNC DETECTED | \"\n           \
      \     f\"mode={mode} | errors={distance}/4096 | \"\n                f\"soft_score={soft_score:.4f}\
      \ | \"\n                f\"soft_threshold={self.soft_score_threshold:.3f} |\
      \ \"\n                f\"detection={self.detections}\"\n            )\n\n  \
      \  def _emit(self):\n        packed = np.packbits(\n            self.buf[:self.target_bits],\n\
      \            bitorder=\"big\"\n        )\n\n        if len(packed) != self.fixed_bytes:\n\
      \            print(\n                \"INTERNAL LENGTH ERROR | \"\n        \
      \        f\"got={len(packed)} expected={self.fixed_bytes}\"\n            )\n\
      \            self._reset_search()\n            return\n\n        vec = pmt.init_u8vector(len(packed),\
      \ packed.tolist())\n        self.message_port_pub(\n            self.out_port,\n\
      \            pmt.cons(pmt.PMT_NIL, vec)\n        )\n\n        soft_bytes = self.soft_buf[:self.soft_target_bits].astype(\n\
      \            \"<f4\", copy=False\n        ).tobytes()\n        soft_vec = pmt.init_u8vector(len(soft_bytes),\
      \ array.array(\"B\", soft_bytes))\n        self.message_port_pub(\n        \
      \    self.soft_out_port,\n            pmt.cons(pmt.PMT_NIL, soft_vec)\n    \
      \    )\n\n        print(\n            \"RF PAYLOAD EMITTED | \"\n          \
      \  f\"hard={len(packed)} bytes | \"\n            f\"soft={self.soft_target_bits}\
      \ float32 values\"\n        )\n\n        self._reset_search()\n\n    def general_work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        s = input_items[1]\n\
      \        n = min(len(x), len(s))\n\n        for idx in range(n):\n         \
      \   bit = int(x[idx]) & 1\n            soft = float(s[idx])\n\n            if\
      \ self.state == \"SEARCH\":\n                self.shiftreg = (\n           \
      \         ((self.shiftreg << 1) | bit) & self.sync_mask\n                )\n\
      \n                # Save the soft metric at exactly the same stream position.\n\
      \                self.sync_soft_buf[self.sync_soft_write] = soft\n         \
      \       self.sync_soft_write += 1\n                if self.sync_soft_write >=\
      \ self.sync_len:\n                    self.sync_soft_write = 0\n\n         \
      \       if self.search_count < self.sync_len:\n                    self.search_count\
      \ += 1\n\n                if self.search_count >= self.sync_len:\n         \
      \           distance = (\n                        self.shiftreg ^ self.sync_int\n\
      \                    ).bit_count()\n\n                    # Very safe hard decision.\n\
      \                    if distance <= self.hard_threshold:\n                 \
      \       self._start_packet(distance, \"hard\")\n\n                    # Rescue\
      \ packets that are slightly too noisy for the hard\n                    # detector\
      \ only when confidence-weighted soft correlation\n                    # also\
      \ agrees with the known sync word.\n                    elif distance <= self.soft_candidate_threshold:\n\
      \                        score = self._soft_sync_score()\n                 \
      \       if score >= self.soft_score_threshold:\n                           \
      \ self._start_packet(distance, \"soft-rescue\", score)\n\n                continue\n\
      \n            if self.state == \"SKIP\":\n                self.skip_left -=\
      \ 1\n                if self.skip_left <= 0:\n                    self.state\
      \ = \"COLLECT\"\n                    self.pos = 0\n                continue\n\
      \n            if self.state == \"COLLECT\":\n                self.buf[self.pos]\
      \ = bit\n                self.soft_buf[self.pos] = soft\n                self.pos\
      \ += 1\n\n                if self.pos >= self.target_bits:\n               \
      \     self._emit()\n\n        self.consume(0, n)\n        self.consume(1, n)\n\
      \        return 0\n"
    affinity: ''
    alias: ''
    comment: 'Balanced low-SNR detector: hard <=1840; soft rescue only for 1841..1900
      with normalized score >=0.12. This reduces false/orphan payloads while retaining
      rescue of previously observed real packets (e.g. 1872 errors, score 0.1457).'
    maxoutbuf: '0'
    minoutbuf: '0'
    plain_bytes: '1502'
    skip_header_bits: '96'
    soft_bits: '12016'
    sync_tag: '"unused"'
    vogeo_bytes: '1502'
  states:
    _io_cache: '(''4096-bit hard+soft low-SNR detector'', ''blk'', [(''skip_header_bits'',
      ''96''), (''plain_bytes'', ''488''), (''soft_bits'', ''3900''), (''vogeo_bytes'',
      ''488''), (''sync_tag'', "''unused''")], [(''0'', ''byte'', 1), (''1'', ''float'',
      1)], [(''soft_pdus'', ''message'', 1), (''pdus'', ''message'', 1)], ''\n    4096-bit
      low-SNR packet detector with soft-assisted acquisition.\n\n    Input 0: differentially
      decoded hard bits (uint8)\n    Input 1: aligned DBPSK soft metric (float32),
      negative=0, positive=1\n\n    Detection policy:\n      1) hard accept when Hamming
      distance <= 1840/4096\n      2) for 1841..1900 errors, accept only when normalized
      soft\n         correlation with the known 4096-bit sync word is >= 0.10\n\n    Packet
      extraction / UDP payload behavior is unchanged.\n    '', [''skip_header_bits''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1272, 836.0]
    rotation: 0
    state: enabled
- name: epy_dbpsk_soft
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    Differential-BPSK soft metric (vectorized).\n\n    Input: one\
      \ complex symbol/sample per BPSK symbol after Symbol Sync + Costas.\n    Output\
      \ convention matches bipolar bits used by the neural classifier:\n        negative\
      \ -> bit 0\n        positive -> bit 1\n        magnitude -> confidence\n\n \
      \   For DBPSK:\n        soft[k] = -Re{ r[k] * conj(r[k-1]) }\n\n    The initial\
      \ previous symbol is constellation index 0 = -1, matching the\n    differential\
      \ encoder/decoder initial state used by the current flowgraph.\n\n    Vectorized\
      \ (no per-sample Python loop) so it can keep up with the USRP\n    source at\
      \ full sample rate without causing input overflows.\n    \"\"\"\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name=\"DBPSK\
      \ soft metric (-Re[r_k r*_{k-1}])\",\n            in_sig=[np.complex64],\n \
      \           out_sig=[np.float32],\n        )\n        self.prev = np.complex64(-1.0\
      \ + 0.0j)\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        y = output_items[0]\n        n = len(x)\n        if n == 0:\n     \
      \       return 0\n\n        prev_arr = np.empty(n, dtype=np.complex64)\n   \
      \     prev_arr[0] = self.prev\n        if n > 1:\n            prev_arr[1:] =\
      \ x[:-1]\n\n        y[:] = -np.real(x * np.conj(prev_arr))\n        self.prev\
      \ = x[-1]\n        return n\n"
    affinity: ''
    alias: ''
    comment: One soft value per differentially decoded BPSK bit. Negative=0, positive=1;
      magnitude is confidence.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''DBPSK soft metric (-Re[r_k r*_{k-1}])'', ''blk'', [], [(''0'',
      ''complex'', 1)], [(''0'', ''float'', 1)], ''\n    Differential-BPSK soft metric
      (vectorized).\n\n    Input: one complex symbol/sample per BPSK symbol after
      Symbol Sync + Costas.\n    Output convention matches bipolar bits used by the
      neural classifier:\n        negative -> bit 0\n        positive -> bit 1\n        magnitude
      -> confidence\n\n    For DBPSK:\n        soft[k] = -Re{ r[k] * conj(r[k-1])
      }\n\n    The initial previous symbol is constellation index 0 = -1, matching
      the\n    differential encoder/decoder initial state used by the current flowgraph.\n\n    Vectorized
      (no per-sample Python loop) so it can keep up with the USRP\n    source at full
      sample rate without causing input overflows.\n    '', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 696.0]
    rotation: 0
    state: enabled
